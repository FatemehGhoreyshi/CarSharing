### LOGIN
# Login as Fleet Manager
# ATTENTION: You will receive a token string, which you have to use in the Authorization-Header of the following Requests for authentication!
POST http://localhost:8080/api/users/login
Content-Type: application/json;charset=UTF-8

{
  "username" : "rudi",
  "password" : "0000"
}


###
# Login as normal driver
# ATTENTION: You will receive a token string, which you have to use in the Authorization-Header of the following Requests for authentication!
POST http://localhost:8080/api/users/login
Content-Type: application/json;charset=UTF-8

{
"username" : "susi",
"password" : "1234"
}



### READ ALL USERS
