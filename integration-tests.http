### CREATE
# Create some users
POST http://localhost:8080/api/users/register
Content-Type: application/json;charset=UTF-8

{
  "username" : "rudi",
  "password" : "0000",
  "firstname" : "Rudi",
  "lastname": "Ratlos",
  "age" : 33,
  "drivingLicenseNr": "1234567890",
  "creditCardNr": "1234-5678-0000-0000-1234",
  "isRoleFleetManager": true
}


